# CivicLens environment template.
# Copy to .env locally if you need overrides. Do not commit a real .env.
# Values below are placeholders. They are not credentials.

# --- FastAPI backend (backend/app/core/config.py) ---
# Optional. Default: CivicLens API
APP_NAME=CivicLens API

# Optional. One of: development, test, production. Default: development
ENVIRONMENT=development

# Optional. true or false. Default: false
DEBUG=false

# Optional. Interface uvicorn binds to when started as a script. Default: 0.0.0.0
API_HOST=0.0.0.0

# Optional. Port for that same script. Default: 8000
PORT=8000

# Optional until a database session is requested.
# Canonical database setting for FastAPI and the document pipeline. No default.
# Consumed by backend/app/core/config.py, backend/app/database.py, and pipeline/load.py.
# Neither component reads POSTGRES_HOST or the other POSTGRES_* names.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/civiclens

# Optional. Comma-separated browser origins, or * . Default: *
# Consumed by backend/main.py when installing CORS.
CORS_ORIGINS=*

# Optional. CRITICAL, ERROR, WARNING, INFO, or DEBUG. Default: INFO
# Consumed by backend/main.py for the process log level.
LOG_LEVEL=INFO

# --- Official Postgres image ---
# Not read by FastAPI or pipeline/load.py. The loader uses DATABASE_URL and
# does not assemble a connection from these names. docker-compose.yml sets
# its own values for the Postgres image.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civiclens
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

# --- Experiment tracking only (tracking/config.py) ---
# Not read by the FastAPI settings object.
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Next.js server route only (frontend/src/lib/ai.ts) ---
# Not read by the FastAPI settings object.
# Do not prefix this with NEXT_PUBLIC_. That would ship it to the browser.
HUGGINGFACE_API_KEY=your_key_here

# REDIS_URL is set by docker-compose for a Redis container.
# No backend module reads it yet, so it is not part of Settings.
